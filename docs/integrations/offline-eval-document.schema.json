{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amplitude.com/schemas/offline-eval-document-1.json",
  "title": "OfflineEvalDocument",
  "description": "One arm of an offline eval bake-off, or one chunk of a larger run. schema_version is 1. See offline-eval.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "source",
    "runner_name",
    "runner_version",
    "ran_at",
    "content_mode",
    "dataset",
    "evaluators",
    "arms"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "project_id": { "type": "string", "pattern": "^[0-9]+$" },
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runner_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runner_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "git_sha": { "type": "string", "minLength": 1, "maxLength": 64 },
    "ran_at": { "type": "string", "format": "date-time" },
    "content_mode": { "enum": ["full", "metadata"] },
    "group_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "chunk_index": { "type": "integer", "minimum": 0 },
    "chunk_count": { "type": "integer", "minimum": 1 },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rows"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "gold_dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "body": {}
            }
          }
        }
      }
    },
    "evaluators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "source": { "enum": ["ootb", "custom"] },
          "kind": { "enum": ["detector", "classifier", "rubric"] },
          "issue_labels": { "type": "array", "maxItems": 32 },
          "critical": { "type": "boolean" },
          "score_min": { "type": "number" },
          "score_max": { "type": "number" },
          "maps_to_evaluator_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "labels"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "provider": { "type": "string" },
          "model_id": { "type": "string" },
          "model_version": { "type": "string" },
          "prompt_version": { "type": "string" },
          "prompt_text": { "type": "string" },
          "agent_version": { "type": "string" },
          "baseline": { "type": "boolean" },
          "labels": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["row_id", "evaluator_id", "value", "grade_source"],
              "properties": {
                "row_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "evaluator_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "value": { "type": ["boolean", "number", "string"] },
                "grade_source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "reviewed_by": { "type": "string" },
                "cost_usd": { "type": "number", "minimum": 0 },
                "latency_ms": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
