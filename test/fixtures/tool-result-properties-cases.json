{
  "description": "Shared validation cases for tool result properties. Mirrored byte-for-byte in Amplitude-AI-Node test/fixtures/tool-result-properties-cases.json.",
  "cases": [
    {
      "name": "valid_scalars",
      "input": { "order_id": "ord_1", "order_value": 42.5, "items": 3, "gift": true },
      "expected": { "order_id": "ord_1", "order_value": 42.5, "items": 3, "gift": true }
    },
    {
      "name": "reserved_prefixes_dropped",
      "input": { "[Agent] Tool Name": "x", "[Amplitude] Session Replay ID": "y", "$revenue": 1, "order_id": "ok" },
      "expected": { "order_id": "ok" }
    },
    {
      "name": "non_scalar_values_dropped",
      "input": { "nested": { "a": 1 }, "list": [1, 2], "none": null, "order_id": "ok" },
      "expected": { "order_id": "ok" }
    },
    {
      "name": "empty_key_dropped",
      "input": { "": "x", "order_id": "ok" },
      "expected": { "order_id": "ok" }
    },
    {
      "name": "cap_at_five_keys_in_order",
      "input": { "a": 1, "b": 2, "c": 3, "d": 4, "e": 5, "f": 6 },
      "expected": { "a": 1, "b": 2, "c": 3, "d": 4, "e": 5 }
    },
    {
      "name": "invalid_entries_do_not_count_toward_cap",
      "input": { "$x": 1, "a": 1, "b": [2], "c": 3, "d": 4, "e": 5, "f": 6 },
      "expected": { "a": 1, "c": 3, "d": 4, "e": 5, "f": 6 }
    }
  ]
}
