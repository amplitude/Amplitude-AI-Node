      "expected": {
        "[Agent] Experiments": [
          "prompt:v2"
        ],
        "[Agent] Experiment Key": "prompt",
        "[Agent] Experiment Variant": "v2",
        "[Agent] Experiment Unit": "turn",
        "[Agent] Experiment Provider": "statsig"
      },
      "debug_logs": 0
